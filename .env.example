# Copy to .env and edit only values that differ on your host.
VLLM_IMAGE=local/b70-qwen38-vllm:q128-m04-196k-180w
MODEL_ID=mikeinnyc/Qwen3.8-27B-GPTQ-Int4-sym-G128-MTP-BF16
MODEL_REVISION=a47b0c6f0d756bc394c4cc629d5b0ded1acc7001
SERVED_MODEL_NAME=Qwen3.8-27B

# Safe default: only the local machine can reach the unauthenticated API.
VLLM_HOST=127.0.0.1
PORT=8081
RENDER_NODE=/dev/dri/renderD128
ZE_AFFINITY_MASK=0

CONTEXT_SIZE=200704
GPU_MEMORY_UTILIZATION=0.93
MAX_NUM_BATCHED_TOKENS=4096
SPECULATIVE_TOKENS=4
MAX_NUM_SEQS=1
PREFIX_CACHING=1
B70_POWER_LIMIT_W=180

# The model must already be present in this cache before offline serving.
# HF_HOME=/home/you/.cache/huggingface
