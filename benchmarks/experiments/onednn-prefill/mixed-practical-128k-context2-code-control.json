  "task_output": "def solve(keys, capacity):\n    if capacity == 0:\n        return {'hits': 0, 'cache': []}\n    \n    from collections import OrderedDict\n    cache = OrderedDict()\n    hits = 0\n    \n    for key in keys:\n        if key in cache:\n            hits += 1\n            cache.move_to_end(key)\n        else:\n            if len(cache) >= capacity:\n                cache.popitem(last=False)\n            cache[key] = None\n            \n    return {'hits': hits, 'cache': list(cache.keys())}",
