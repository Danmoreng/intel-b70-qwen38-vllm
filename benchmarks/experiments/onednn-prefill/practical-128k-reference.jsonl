the value is not a valid float, ignore it\n                pass\n                \n    return total\n```", "score": {"passed": true, "test_results": [{"passed": true, "actual": 4.0}, {"passed": true, "actual": 0.0}, {"passed": true, "actual": 97.5}]}, "ttft_s": 3.847320180000679, "wall_s": 11.589590918001704, "usage": {"prompt_tokens": 131070, "total_tokens": 131455, "completion_tokens": 385, "completion_tokens_details": {"reasoning_tokens": 0}}, "finish_reason": "stop", "metrics": {"prefill_tokens": 2942.0, "prefill_s": 3.6734447890012234, "decode_s": 7.766126735999933, "cached_tokens": 128128.0, "preemptions": 0.0, "draft_tokens": 444.0, "accepted_tokens": 275.0}}
