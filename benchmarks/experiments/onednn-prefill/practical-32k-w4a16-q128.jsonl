   nodes.add(before)\n        nodes.add(after)\n        graph[before].append(after)\n        in_degree[after] += 1\n    \n    for node in nodes:\n        if node not in in_degree:\n            in_degree[node] = 0\n    \n    heap = [node for node in nodes if in_degree[node] == 0]\n    heapq.heapify(heap)\n    \n    result = []\n    \n    while heap:\n        node = heapq.heappop(heap)\n        result.append(node)\n        \n        for neighbor in graph[node]:\n            in_degree[neighbor] -= 1\n            if in_degree[neighbor] == 0:\n                heapq.heappush(heap, neighbor)\n    \n    if len(result) != len(nodes):\n        return []\n    \n    return result\n```", "score": {"passed": true, "test_results": [{"passed": true, "actual": ["a", "b", "c"]}, {"passed": true, "actual": []}, {"passed": true, "actual": []}, {"passed": true, "actual": ["z", "a", "b"]}]}, "ttft_s": 2.9774844059975294, "wall_s": 9.634119071997702, "usage": {"prompt_tokens": 32760, "total_tokens": 33301, "completion_tokens": 541, "completion_tokens_details": {"reasoning_tokens": 0}}, "finish_reason": "stop", "metrics": {"prefill_tokens": 2808.0, "prefill_s": 2.9336493669979973, "decode_s": 6.662402328001917, "cached_tokens": 29952.0, "preemptions": 0.0, "draft_tokens": 556.0, "accepted_tokens": 405.0}}
