{"id": "context-5-code-2", "kind": "code", "arm": "w4a8-q128", "image": "sha256:47c9d5fc5eb28fd12ef6219fbbfe7cf3863e00aa0535da377cadfc9a181bcd41", "context_sha256": "629b4c37394278f29c90ce082e4af92698cb6688ceb737cc337544b7ae85d4fb", "prompt_sha256": "b630d5fe59bb23ad965eed3ac7707603bee6b81569db553089bbc0c8d6ef3b5b", "output_sha256": "c52b154dc232bb7be17247f07ee7ce8c4f04bbc00552f55c44b3270d86d6863d", "output": "```python\ndef solve(edges):\n    from collections import defaultdict, deque\n\n    graph = defaultdict(list)\n    in_degree = defaultdict(int)\n    nodes = set()\n\n    for before, after in edges:\n        nodes.add(before)\n        nodes.add(after)\n        graph[before].append(after)\n        in_degree[after] += 1\n\n    # Initialize in-degree for all nodes\n    for node in nodes:\n        if node not in in_degree:\n            in_degree[node] = 0\n\n    # Use a min-heap for lexicographically smallest topological order\n    import heapq\n    heap = [node for node in nodes if in_degree[node] == 0]\n    heapq.heapify(heap)\n\n    result = []\n    while heap:\n        node = heapq.heappop(heap)\n        result.append(node)\n        for neighbor in graph[node]:\n            in_degree[neighbor] -= 1\n            if in_degree[neighbor] == 0:\n                heapq.heappush(heap, neighbor)\n\n    if len(result) != len(nodes):\n        return []\n    \n    return result\n```", "score": {"passed": true, "test_results": [{"passed": true, "actual": ["a", "b", "c"]}, {"passed": true, "actual": []}, {"passed": true, "actual": []}, {"passed": true, "actual": ["z", "a", "b"]}]}, "ttft_s": 2.38571835899711, "wall_s": 5.321764370997698, "usage": {"prompt_tokens": 32760, "total_tokens": 33004, "completion_tokens": 244, "completion_tokens_details": {"reasoning_tokens": 0}}, "finish_reason": "stop", "metrics": {"prefill_tokens": 2808.0, "prefill_s": 2.343135117997008, "decode_s": 2.9420569140020234, "cached_tokens": 29952.0, "preemptions": 0.0, "draft_tokens": 228.0, "accepted