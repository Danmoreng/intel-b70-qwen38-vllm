labels are key=\"value\" and values are quoted.\n        # But the prompt says \"metric_name{optional labels} number\".\n        # Standard Prometheus exposition format:\n        # metric_name{label1=\"value1\",label2=\"value2\"} 123.45\n        # The value is always the last field separated by whitespace.\n        \n        parts = line.split()\n        if not parts:\n            continue\n        \n        try:\n            value = float(parts[-1])\n        except ValueError:\n            continue\n            \n        total += value\n        \n    return total\n```", "score": {"passed": true, "test_results": [{"passed": true, "actual": 4.0}, {"passed": true, "actual": 0.0}, {"passed": true, "actual": 97.5}]}, "ttft_s": 1.7844805360000464, "wall_s": 9.305742487998941, "usage": {"prompt_tokens": 32761, "total_tokens": 33257, "completion_tokens": 496, "completion_tokens_details": {"reasoning_tokens": 0}}, "finish_reason": "stop", "metrics": {"prefill_tokens": 2809.0, "prefill_s": 1.7430896059995575, "decode_s": 7.527465773000586, "cached_tokens": 29952.0, "preemptions": 0.0, "draft_tokens": 588.0, "accepted_tokens": 352.0}}
