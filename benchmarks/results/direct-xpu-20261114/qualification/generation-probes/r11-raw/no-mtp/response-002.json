              "arguments": "{\"path\": \"rangeset.py\", \"content\": \"class RangeSet:\\n    \\\"\\\"\\\"A normalized set of half-open integer ranges [start, end).\\\"\\\"\\\"\\n\\n    def __init__(self, ranges=()):\\n        pairs = []\\n        for start, end in ranges:\\n            self._check_endpoints(start, end)\\n            pairs.append((start, end))\\n        self._ranges = self._normalize(pairs)\\n\\n    @staticmethod\\n    def _check_endpoints(start, end):\\n        if type(start) is not int or type(end) is not int:\\n            raise TypeError(\\\"endpoints must be of exact type int\\\")\\n        if start > end:\\n            raise ValueError(\\\"start must be <= end\\\")\\n\\n    @staticmethod\\n    def _normalize(intervals):\\n        merged = []\\n        for a, b in sorted(intervals):\\n            if b <= a:\\n                continue\\n            if merged and a <= merged[-1][1]:\\n                prev_a, prev_b = merged[-1]\\n                merged[-1] = (prev_a, max(prev_b, b))\\n            else:\\n                merged.append((a, b))\\n        return merged\\n\\n    def ranges(self):\\n        return [tuple(r) for r in self._ranges]\\n\\n    def add(self, start, end):\\n        self._check_endpoints(start, end)\\n        if start >= end:\\n            return\\n        self._ranges = self._normalize(self._ranges + [(start, end)])\\n\\n    def remove(self, start, end):\\n        self._check_endpoints(start, end)\\n        if start >= end:\\n            return\\n        pieces = []\\n        for a, b in self._ranges:\\n            if b <= start or a >= end:\\n                pieces.append((a, b))\\n                continue\\n            if a < start:\\n                pieces.append((a, start))\\n            if end < b:\\n                pieces.append((end, b))\\n        self._ranges = self._normalize(pieces)\\n\\n    def contains(self, point):\\n        if type(point) is not int:\\n            raise TypeError(\\\"point must be of exact type int\\\")\\n        for a, b in self._ranges:\\n            if a <= point < b:\\n                return True\\n            if point < a:\\n                break\\n        return False\\n\\n    def clip(self, start, end):\\n        self._check_endpoints(start, end)\\n        if start >= end:\\n            return []\\n        return self._normalize(\\n            (max(a, start), min(b, end))\\n            for a, b in self._ranges\\n            if a < end and b > start\\n        )\\n\"}"
