              "arguments": "{\"path\": \"rangeset.py\", \"content\": \"class RangeSet:\\n    \\\"\\\"\\\"A normalized set of half-open integer ranges [start, end).\\\"\\\"\\\"\\n\\n    def __init__(self, ranges=()):\\n        self._ranges = self._normalize(self._validated(ranges))\\n\\n    # ------------------------------------------------------------------ #\\n    # validation helpers\\n    # ------------------------------------------------------------------ #\\n    @staticmethod\\n    def _check_int(value, name):\\n        if type(value) is not int:\\n            raise TypeError(\\\"%s must be int, got %s\\\" % (name, type(value).__name__))\\n\\n    @classmethod\\n    def _check_pair(cls, start, end):\\n        cls._check_int(start, \\\"start\\\")\\n        cls._check_int(end, \\\"end\\\")\\n        if start > end:\\n            raise ValueError(\\\"start must be <= end, got (%d, %d)\\\" % (start, end))\\n\\n    @classmethod\\n    def _validated(cls, pairs):\\n        result = []\\n        for pair in pairs:\\n            start, end = pair\\n            cls._check_pair(start, end)\\n            if start < end:\\n                result.append((start, end))\\n        return result\\n\\n    # ------------------------------------------------------------------ #\\n    # normalization helpers\\n    # ------------------------------------------------------------------ #\\n    @staticmethod\\n    def _merge(intervals):\\n        merged = []\\n        for start, end in sorted(intervals):\\n            if merged and start <= merged[-1][1]:\\n                prev_start, prev_end = merged[-1]\\n                merged[-1] = (prev_start, max(prev_end, end))\\n            else:\\n                merged.append((start, end))\\n        return merged\\n\\n    def _normalize(self, intervals):\\n        return self._merge(intervals)\\n\\n    # ------------------------------------------------------------------ #\\n    # public API\\n    # ------------------------------------------------------------------ #\\n    def ranges(self):\\n        return [tuple(r) for r in self._ranges]\\n\\n    def add(self, start, end):\\n        self._check_pair(start, end)\\n        if start < end:\\n            self._ranges = self._normalize(self._ranges + [(start, end)])\\n\\n    def remove(self, start, end):\\n        self._check_pair(start, end)\\n        if start < end:\\n            remaining = []\\n            for a, b in self._ranges:\\n                if b <= start or a >= end:\\n                    remaining.append((a, b))\\n                else:\\n                    if a < start:\\n                        remaining.append((a, start))\\n                    if end < b:\\n                        remaining.append((end, b))\\n            self._ranges = self._normalize(remaining)\\n\\n    def contains(self, point):\\n        self._check_int(point, \\\"point\\\")\\n        return any(a <= point < b for a, b in self._ranges)\\n\\n    def clip(self, start, end):\\n        self._check_pair(start, end)\\n        if start >= end:\\n            return []\\n        clipped = []\\n        for a, b in self._ranges:\\n            lo, hi = max(a, start), min(b, end)\\n            if lo < hi:\\n                clipped.append((lo, hi))\\n        return self._merge(clipped)\\n\"}"
