+# Initial functional port. Native attention; no inherited GPTQ performance routes.
+ARG BASE_IMAGE=sha256:ed1ebca756abb0e0832d11cd0db026dd7e86df094c6903efe7ae8afbdc290b68
+FROM ${BASE_IMAGE}
+USER root
+WORKDIR /opt/exl3xpu
+COPY pyproject.toml ./
+COPY exl3xpu ./exl3xpu
+COPY csrc ./csrc
+COPY scripts ./scripts
+COPY models ./models
+COPY tests ./tests
+COPY .native-target/_C.so .native-target/_C.so.manifest.json ./exl3xpu/
+COPY .m04-target/ ./m04/
+COPY .target-integration/ /tmp/exl3-integration/
+RUN python scripts/verify_native_artifact.py \
+ && python /tmp/exl3-integration/patch_mtp_format_guard.py --vllm-root /opt/venv/lib/python3.12/site-packages/vllm \
+ && python scripts/prepare_target_runtime.py \
+ && pip install --no-deps --no-build-isolation -e . \
+ && python -c "from importlib.metadata import entry_points; assert any(e.name=='exl3xpu' for e in entry_points(group='vllm.general_plugins'))" \
+ && rm -rf /tmp/exl3-integration
+ENV MODELS_DIR=/models EXL3_TARGET_RUNTIME=vllm030 EXL3_FIX_SPARSE_GDN_RETIREMENT=0 \
+    B70_GPTQ_W4A8_PREFILL=0 B70_ONEDNN_PREFILL=0 B70_ONEDNN_MIXED_ROUTE=0
+ENTRYPOINT ["python", "scripts/serve.py"]
+CMD ["models/qwen3.8-27b-exl3-4.00bpw/migration-target-200704-c4.yaml", "--gpu", "0"]
