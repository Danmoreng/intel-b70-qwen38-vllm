diff --git a/tests/test_bounded_partition_cache.cpp b/tests/test_bounded_partition_cache.cpp
new file mode 100644
index 0000000..415ece1
--- /dev/null
+++ b/tests/test_bounded_partition_cache.cpp
@@ -0,0 +1,42 @@
+#include "bounded_partition_cache.h"
+#include <cassert>
+#include <memory>
+#include <iostream>
+
+struct State { bool busy; bool unsafe_destroy=false; unsigned waits=0; };
+struct Value {
+    std::shared_ptr<State> state;
+    explicit Value(std::shared_ptr<State> s):state(std::move(s)) {}
+    Value(Value&&)=default;
+    ~Value() { if (state && state->busy) state->unsafe_destroy=true; }
+};
+int main() {
+    auto ready=[](const Value& v){return !v.state->busy;};
+    auto wait=[](const Value& v){v.state->busy=false;++v.state->waits;};
+    {
+        auto a=std::make_shared<State>(State{true}),b=std::make_shared<State>(State{true}),c=std::make_shared<State>(State{false});
+        BoundedPartitionCache<int,Value> cache(2);
+        cache.get(1,[&]{return Value(a);},ready,wait);
+        cache.get(2,[&]{return Value(b);},ready,wait);
+        cache.get(1,[]{throw std::runtime_error("hot hit compiled");return Value(nullptr);},ready,wait);
+        cache.get(3,[&]{return Value(c);},ready,wait);
+        assert(cache.size()==2 && cache.stats.peak_entries==2);
+        assert(cache.stats.hits==1 && cache.stats.misses==3 && cache.stats.evictions==1);
+        assert(cache.stats.pressure_waits==1 && b->waits==1 && !b->unsafe_destroy);
+        a->busy=false;
+    }
+    {
+        auto a=std::make_shared<State>(State{true}),b=std::make_shared<State>(State{false}),c=std::make_shared<State>(State{false});
+        BoundedPartitionCache<int,Value> cache(2);
+        cache.get(1,[&]{return Value(a);},ready,wait);
+        cache.get(2,[&]{return Value(b);},ready,wait);
+        cache.get(3,[&]{return Value(c);},ready,wait);
+        assert(cache.stats.pressure_waits==0 && !b->unsafe_destroy && a->waits==0);
+        bool failed=false;
+        try {cache.get(4,[]{throw std::runtime_error("compile fails");return Value(nullptr);},ready,wait);}
+        catch (const std::runtime_error&) {failed=true;}
+        assert(failed && cache.size()<2 && !a->unsafe_destroy);
+        a->busy=false;
+    }
+    std::cout<<"PASS bounded LRU, hot hits, async retirement, pressure-only wait, compile failure\n";
+}
diff --git a/tests/test_m04_output_copy.py b/tests/test_m04_output_copy.py
new file mode 100644
index 0000000..98857ec
--- /dev/null
+++ b/tests/test_m04_output_copy.py
@@ -0,0 +1,35 @@
+"""Exercise the actual run() output path with a deterministic stand-in kernel."""
+import unittest
+from unittest.mock import patch
+import torch
+from exl3xpu import shared_kv_verify as m04
+
+
+class CopyContract(unittest.TestCase):
+    def test_native_output_and_no_output_preserve_all_half_bitpatterns(self):
+        for batch in (1, 2, 4):
+            for rows in (2, 3, 4, 5):
+                with self.subTest(batch=batch, rows=rows):
+                    count=batch*rows*24*256
+                    bits=((torch.arange(count,dtype=torch.int64)%65536)-32768).to(torch.int16)
+                    y=bits.view(torch.float16).reshape(batch,rows*24,256)
+                    expected=m04.unpacked_output(y,batch,rows)
+                    def kernel(*args):
+                        args[8].copy_(y)
+                    for has_out in (True, False):
+                        q=torch.zeros((batch*rows,24,256),dtype=torch.float16)
+                        out=torch.empty_like(q) if has_out else None
+                        d=dict(q=q,k=q,v=q,block_table=torch.zeros((batch,1),dtype=torch.int32),
+                               cu_seqlens_q=torch.arange(batch+1,dtype=torch.int32),
+                               seqused_k=torch.ones(batch,dtype=torch.int32),
+                               k_descale=torch.ones(1),v_descale=torch.ones(1),
+                               max_seqlen_q=rows,max_seqlen_k=4096,out=out)
+                        with patch.object(torch.ops.b70_exl3_attention,'shared_kv_verify_out',kernel,create=True):
+                            actual=m04.run(d)
+                        self.assertTrue(torch.equal(actual.view(torch.int16),expected.view(torch.int16)))
+                        if has_out:
+                            self.assertIs(actual,out)
+                            self.assertEqual(actual.data_ptr(),out.data_ptr())
+
+
+if __name__=='__main__':unittest.main()
